# Fill in ONLY the keys you have. Empty = skipped automatically. The framework
# works with ZERO keys if you have Ollama running locally.
OPENAI_API_KEY=
# Anthropic Claude models
ANTHROPIC_API_KEY=
# Google Gemini models
GEMINI_API_KEY=
# Groq (Llama, Mixtral) models
GROQ_API_KEY=
# Ollama configuration (local/free models)
OLLAMA_BASE_URL=http://localhost:11434

# Generic slot for any other OpenAI-compatible host (Kimi, Qwen, Ling, DeepSeek,
# OpenRouter, Together, Fireworks, etc.) — set both to use it:
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_NAME=
